{
  "name": "dragons-down",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "extract": ".venv/bin/python scripts/extract.py --all && npm run transform && npm run derive && npm run extract-tts",
    "steam:download": "steamcmd +force_install_dir \"$PWD/.cache/steamcmd\" +login anonymous +workshop_download_item 286160 3062060625 +quit",
    "steam:copy-json": "tsx scripts/copy-tts-workshop-source.ts",
    "steam:refresh-json": "npm run steam:download && npm run steam:copy-json",
    "check:lost-battalion": "tsx scripts/check-lost-battalion.ts",
    "transform": "tsx scripts/transform.ts",
    "derive": "tsx scripts/derive.ts",
    "extract-mission-kinds": "tsx scripts/extract-mission-kinds.ts",
    "extract-tts": "tsx scripts/extract-tts.ts",
    "extract-map-tiles": "tsx scripts/extract-map-tiles.ts",
    "missing-cards": "tsx scripts/missing-cards.ts",
    "inspect-fonts": ".venv/bin/python scripts/inspect_fonts.py",
    "find-images": "tsx scripts/find-images.ts",
    "download-images": "tsx scripts/download-images.ts",
    "download-activemagic-images": "tsx scripts/download-activemagic-images.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bson": "^7.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fs-extra": "^11.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
